#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/moranmanuel/develop/split-bot/node_modules/.pnpm/ultracite@7.2.4/node_modules/ultracite/node_modules:/home/moranmanuel/develop/split-bot/node_modules/.pnpm/ultracite@7.2.4/node_modules:/home/moranmanuel/develop/split-bot/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/moranmanuel/develop/split-bot/node_modules/.pnpm/ultracite@7.2.4/node_modules/ultracite/node_modules:/home/moranmanuel/develop/split-bot/node_modules/.pnpm/ultracite@7.2.4/node_modules:/home/moranmanuel/develop/split-bot/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.pnpm/ultracite@7.2.4/node_modules/ultracite/dist/index.js" "$@"
else
  exec node  "$basedir/../.pnpm/ultracite@7.2.4/node_modules/ultracite/dist/index.js" "$@"
fi
